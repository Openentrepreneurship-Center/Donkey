# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-api-key

# S3 로그/오디오 저장 (비우면 S3에 저장 안 함)
# 버킷명: Terraform 적용 후 `terraform -chdir=infra output -raw s3_logs_bucket` 로 확인
# S3_LOGS_BUCKET=donkey-logs-123456789012
# S3_LOGS_PREFIX=job-logs
# AWS_REGION=ap-northeast-2
# SAVE_AUDIO_TO_S3=true

# Optional settings (defaults shown)
# USE_LLM_ONLY_SPEAKER_LABELING=true # true = 발화 블록(턴) 단위로 LLM이 의사/환자 판단 후 전파 (권장)
# USE_RESEMBLYZER_EMBEDDING=true     # false일 때만: Resemblyzer vs MFCC
# WHISPER_SEGMENT_MODEL=whisper-1
# DEFAULT_LANGUAGE=ko
# DEFAULT_STT_MODEL=gpt-4o-mini-transcribe
# DEFAULT_CHAT_MODEL=gpt-4o-mini
# ASYNC_THRESHOLD_SECONDS=30
# MAX_CONCURRENT_JOBS=3
# SAVE_WHISPER_TO_EVAL_DATA=false  # true면 Whisper 전사문을 metrics/eval_data/{job_id}_hyp.txt 로 저장 (지표 평가용)
